# Contact form delivery — set in Vercel → Project → Settings → Environment Variables.
# Option A: email via Resend (https://resend.com). The sender domain must be verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Longform Edits <enquiries@longformedits.com>"
# Option B (can be used alongside A): POST each enquiry as JSON to a webhook (Zapier, Make, Slack, CRM).
CONTACT_WEBHOOK_URL=
