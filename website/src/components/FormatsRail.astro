---
/** Horizontal, snap-scrolling rail of the eight long-form formats. Cards are illustrative art, not client work. */
import { formats } from '../data/services';
const hues = [152, 165, 140, 175, 130, 158, 148, 170];
const thumbs = ['3 MISTAKES', 'LESSON 04', 'THE NUMBERS', 'EP. 112', 'THE STORY', 'NO FACE?', 'FOUNDER', 'DAY 01'];
---
<section class="section rail" aria-labelledby="rail-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow" data-reveal>What we edit</p>
        <h2 id="rail-title" class="h2" data-reveal style="--d:80ms">Eight formats. <em class="serif">One length:</em> long.</h2>
      </div>
      <p class="lede" data-reveal style="--d:140ms">Different formats need different editing instincts. All eight are part of the same service, and every one is edited to be watched start to finish.</p>
    </div>
  </div>
  <div class="rail__scroller" data-rail tabindex="0" aria-label="Formats we edit (scrollable)">
    <ul role="list" class="rail__track">
      {formats.map((f, i) => (
        <li class="rail__card card" style={`--h:${hues[i]}`}>
          <div class="rail__art" aria-hidden="true">
            <span class="rail__thumb">{thumbs[i]}</span>
            <span class="rail__fig"></span>
            <span class="rail__rt mono">{['14:32', '18:05', '12:47', '58:20', '22:10', '11:36', '09:58', '16:44'][i]}</span>
          </div>
          <div class="rail__meta">
            <span class="mono rail__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="rail__name">{f.name}</h3>
            <p>{f.detail}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
  <div class="container rail__ctrl">
    <span class="mono muted">Drag · arrows · example formats</span>
    <div class="rail__btns">
      <button type="button" class="rail__btn" data-rail-prev aria-label="Previous formats">←</button>
      <button type="button" class="rail__btn" data-rail-next aria-label="Next formats">→</button>
    </div>
    <span class="mono muted">Illustrative</span>
  </div>
</section>
<script>
  const sc = document.querySelector<HTMLElement>('[data-rail]');
  if (sc) {
    const step = () => (sc.querySelector('li')?.getBoundingClientRect().width ?? 320) + 16;
    document.querySelector('[data-rail-prev]')?.addEventListener('click', () => sc.scrollBy({ left: -step(), behavior: 'smooth' }));
    document.querySelector('[data-rail-next]')?.addEventListener('click', () => sc.scrollBy({ left: step(), behavior: 'smooth' }));
    // Drag to scroll with a mouse (touch scrolls natively).
    let down = false, x0 = 0, s0 = 0;
    sc.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; x0 = e.clientX; s0 = sc.scrollLeft; sc.classList.add('is-drag'); });
    window.addEventListener('pointermove', (e) => { if (down) sc.scrollLeft = s0 - (e.clientX - x0); });
    window.addEventListener('pointerup', () => { down = false; sc.classList.remove('is-drag'); });
  }
</script>
<style>
  .rail__scroller { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 0.5rem 0 1.5rem; cursor: grab; }
  .rail__scroller::-webkit-scrollbar { display: none; }
  .rail__scroller.is-drag { cursor: grabbing; scroll-snap-type: none; }
  .rail__track { display: flex; gap: 1rem; padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); width: max-content; }
  .rail__card { width: clamp(17rem, 70vw, 23rem); scroll-snap-align: start; overflow: hidden; user-select: none; transition: transform var(--t-med) var(--ease), border-color var(--t-med); }
  .rail__card:hover { transform: translateY(-4px); border-color: rgb(47 209 128 / 0.35); }
  .rail__art { position: relative; aspect-ratio: 16/9; overflow: hidden; background: radial-gradient(80% 100% at 75% 20%, hsl(var(--h) 65% 42%), hsl(var(--h) 70% 12%) 70%); }
  .rail__thumb { position: absolute; left: 0.9rem; top: 0.9rem; max-width: 55%; font-family: var(--font-display); font-weight: 900; font-size: 1.35rem; line-height: 0.95; letter-spacing: -0.03em; color: #fff; text-shadow: 0 2px 0 #000, 0 0 20px rgb(0 0 0 / 0.5); }
  .rail__fig { position: absolute; right: 12%; bottom: -12%; width: 34%; aspect-ratio: 3/4; border-radius: 50% 50% 0 0; background: linear-gradient(180deg, rgb(255 255 255 / 0.28), rgb(255 255 255 / 0.05)); }
  .rail__fig::before { content: ''; position: absolute; left: 50%; top: -42%; translate: -50% 0; width: 52%; aspect-ratio: 1; border-radius: 50%; background: rgb(255 255 255 / 0.3); }
  .rail__rt { position: absolute; right: 0.6rem; bottom: 0.6rem; padding: 0.15rem 0.4rem; border-radius: 3px; background: rgb(0 0 0 / 0.75); color: #fff; font-size: 0.625rem; }
  .rail__meta { padding: 1.1rem 1.2rem 1.3rem; display: grid; gap: 0.35rem; }
  .rail__n { color: var(--brand); }
  .rail__name { font-size: 1.125rem; letter-spacing: -0.02em; }
  .rail__meta p { font-size: 0.875rem; color: var(--ink-2); }
  .rail__ctrl { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--s-4); text-transform: uppercase; }
  .rail__ctrl > span:last-child { text-align: right; }
  .rail__btns { display: flex; gap: 0.5rem; }
  .rail__btn { width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid var(--line-strong); color: var(--ink); transition: background var(--t-fast), border-color var(--t-fast); }
  .rail__btn:hover { background: var(--brand); color: var(--on-brand); border-color: var(--brand); }
  @media (max-width: 600px) { .rail__ctrl > span { display: none; } .rail__ctrl { grid-template-columns: 1fr; justify-items: center; } }
</style>
