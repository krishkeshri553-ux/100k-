---
import Logo from './Logo.astro';
import { nav, cta } from '../config/site';

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || (href !== '/' && current.startsWith(href));
---
<header class="hdr" data-header>
  <div class="container hdr__bar">
    <a href="/" class="hdr__logo" aria-label="Longform Edits — home"><Logo /></a>

    <nav class="hdr__nav" aria-label="Primary">
      <ul role="list">
        {nav.filter((n) => n.href !== '/contact/').map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="hdr__actions">
      <a href="/contact/" class="hdr__contact" aria-current={isActive('/contact/') ? 'page' : undefined}>Contact</a>
      <a href={cta.primary.href} class="btn btn--sm hdr__cta">{cta.primary.label}</a>
      <button class="hdr__toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" data-nav-toggle>
        <span class="sr-only" data-nav-label>Open menu</span>
        <span class="hdr__burger" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="mnav" id="mobile-nav" data-mobile-nav>
    <nav class="container" aria-label="Mobile">
      <ul role="list" class="mnav__list">
        {nav.map((item, i) => (
          <li style={`--i:${i}`}>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>{item.label}
            </a>
          </li>
        ))}
      </ul>
      <a href={cta.primary.href} class="btn btn--block">{cta.primary.label} <span class="btn__arrow" aria-hidden="true">→</span></a>
    </nav>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: var(--paper); border-bottom: 1px solid transparent; transition: border-color var(--t-med) var(--ease); }
  .hdr.is-scrolled { border-bottom-color: var(--line); }
  .hdr__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-5); height: 4.25rem; }
  .hdr__logo { flex: none; }
  .hdr__nav ul { display: flex; gap: var(--s-1); }
  .hdr__nav a, .hdr__contact {
    display: inline-block; padding: 0.5rem 0.8rem; font-size: 0.9375rem; font-weight: 500; color: var(--ink-2);
    border-radius: var(--r-pill); transition: color var(--t-fast), background var(--t-fast);
  }
  .hdr__nav a:hover, .hdr__contact:hover { color: var(--ink); background: var(--paper-2); }
  .hdr__nav a[aria-current='page'], .hdr__contact[aria-current='page'] { color: var(--ink); background: var(--green-tint); }
  .hdr__actions { display: flex; align-items: center; gap: var(--s-2); }

  .hdr__toggle { display: none; width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1px solid var(--line-strong); align-items: center; justify-content: center; }
  .hdr__burger { display: grid; gap: 5px; width: 18px; }
  .hdr__burger i { display: block; height: 1.5px; background: var(--ink); transition: transform var(--t-med) var(--ease); }
  [aria-expanded='true'] .hdr__burger i:first-child { transform: translateY(3.25px) rotate(45deg); }
  [aria-expanded='true'] .hdr__burger i:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  .mnav { display: none; }

  @media (max-width: 960px) {
    .hdr__nav, .hdr__contact { display: none; }
    .hdr__toggle { display: inline-flex; }
    .mnav {
      display: block; position: fixed; inset: 4.25rem 0 0; background: var(--paper);
      padding-block: var(--s-6) var(--s-7); overflow-y: auto;
      visibility: hidden; opacity: 0; transform: translateY(-8px);
      transition: opacity var(--t-med) var(--ease), transform var(--t-med) var(--ease), visibility 0s linear var(--t-med);
    }
    .mnav.is-open { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
    .mnav__list { margin-bottom: var(--s-6); border-top: 1px solid var(--line); }
    .mnav__list a {
      display: flex; align-items: baseline; gap: var(--s-4); padding: 1rem 0; border-bottom: 1px solid var(--line);
      font-size: clamp(1.75rem, 1.2rem + 3vw, 2.5rem); font-weight: 600; letter-spacing: -0.035em; color: var(--ink);
    }
    .mnav__list a .mono { color: var(--green); font-size: 0.75rem; transform: translateY(-0.4em); }
    .mnav__list a[aria-current='page'] { color: var(--green); }
    .mnav__list li { opacity: 0; transform: translateY(10px); transition: opacity var(--t-med) var(--ease), transform var(--t-med) var(--ease); transition-delay: calc(var(--i) * 40ms); }
    .mnav.is-open .mnav__list li { opacity: 1; transform: none; }
  }
  @media (max-width: 420px) {
    .hdr__cta { display: none; }
  }
  /* Without JavaScript the toggle can't work, so show the menu as a static list. */
  :global(html:not(.js)) .hdr__toggle { display: none; }
  @media (max-width: 960px) {
    :global(html:not(.js)) .mnav { position: static; visibility: visible; opacity: 1; transform: none; padding-block: 0 var(--s-5); }
    :global(html:not(.js)) .mnav__list li { opacity: 1; transform: none; }
  }
</style>
