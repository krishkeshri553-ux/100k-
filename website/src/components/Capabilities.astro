---
/**
 * Capabilities as an edit decision list (EDL). Core items are in every
 * package; the rest are applied when the footage or brief calls for them.
 */
import { capabilities } from '../data/services';
---
<section class="section caps" aria-labelledby="caps-title">
  <div class="container caps__grid">
    <div class="caps__intro">
      <p class="eyebrow" data-reveal>Inside an edit</p>
      <h2 id="caps-title" class="h2" data-reveal style="--d:80ms">What actually goes into a <em class="serif">finished</em> video.</h2>
      <p class="lede" data-reveal style="--d:140ms">
        A long video lives or dies on hundreds of small decisions. Here's what we're doing on yours.
      </p>
      <p class="caps__legend mono" data-reveal style="--d:200ms">
        <span><i class="dot dot--core"></i>In every package</span>
        <span><i class="dot"></i>Applied when the video needs it</span>
      </p>
    </div>

    <div class="edl" role="table" aria-label="Editing capabilities">
      <div class="edl__head mono" role="row">
        <span role="columnheader">#</span><span role="columnheader">Event</span><span role="columnheader" class="edl__hide">Notes</span>
      </div>
      {capabilities.map((c, i) => (
        <div class="edl__row" role="row" data-reveal style={`--d:${(i % 6) * 40}ms`}>
          <span class="mono edl__code" role="cell">{c.code}</span>
          <span class="edl__name" role="cell">
            <i class:list={['dot', { 'dot--core': c.core }]} aria-hidden="true"></i>
            {c.name}
            <span class="sr-only">{c.core ? '(included in every package)' : '(applied when the video needs it)'}</span>
          </span>
          <span class="edl__detail" role="cell">{c.detail}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .caps__grid { display: grid; gap: var(--s-7); }
  .caps__intro { display: grid; gap: var(--s-5); align-content: start; }
  .caps__legend { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); color: var(--muted); }
  .caps__legend span { display: inline-flex; align-items: center; gap: var(--s-2); }
  .dot { display: inline-block; width: 0.55rem; height: 0.55rem; border-radius: 50%; border: 1.5px solid var(--green-2); flex: none; }
  .dot--core { background: var(--green-2); }

  .edl { border-top: 1px solid var(--line-strong); }
  .edl__head { display: grid; grid-template-columns: 3rem 1fr; padding: var(--s-3) 0; color: var(--muted); text-transform: uppercase; border-bottom: 1px solid var(--line); }
  .edl__hide { display: none; }
  .edl__row { display: grid; grid-template-columns: 3rem 1fr; gap: var(--s-1) 0; padding: var(--s-4) 0; border-bottom: 1px solid var(--line); }
  .edl__code { color: var(--green); padding-top: 0.2rem; }
  .edl__name { color: var(--ink); font-weight: 600; letter-spacing: -0.015em; display: inline-flex; align-items: center; gap: var(--s-3); }
  .edl__detail { grid-column: 2; font-size: var(--fs-sm); color: var(--ink-2); }
  @media (min-width: 760px) {
    .edl__head, .edl__row { grid-template-columns: 3.5rem minmax(0, 0.9fr) minmax(0, 1.4fr); column-gap: var(--s-5); }
    .edl__hide { display: block; }
    .edl__detail { grid-column: 3; }
  }
  @media (min-width: 1100px) {
    .caps__grid { grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: var(--s-9); }
    .caps__intro { position: sticky; top: 6rem; }
  }
</style>
