---
import type { Post } from '../lib/blog';
import { categoryBySlug } from '../config/blog';
import { formatDate, readingTime } from '../lib/blog';

export interface Props { post: Post; index?: number; large?: boolean }
const { post, index, large = false } = Astro.props;
const cat = categoryBySlug(post.data.category);
---
<article class:list={['bc', { 'bc--large': large }]}>
  <div class="bc__top mono">
    {index !== undefined && <span class="bc__num">{String(index + 1).padStart(2, '0')}</span>}
    <a href={`/blog/category/${post.data.category}/`} class="bc__cat">{cat?.name}</a>
    {post.data.draft && <span class="tag tag--placeholder">Draft</span>}
  </div>
  <h3 class="bc__title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
  <p class="bc__desc">{post.data.description}</p>
  <p class="bc__meta mono">
    <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
    <span>·</span><span>{readingTime(post.body)} min read</span>
  </p>
</article>
<style>
  .bc { position: relative; display: grid; gap: var(--s-3); padding: var(--s-6) 0; border-bottom: 1px solid var(--line); align-content: start; }
  .bc__top { display: flex; align-items: center; gap: var(--s-3); color: var(--muted); text-transform: uppercase; }
  .bc__num { color: var(--green); }
  .bc__cat { position: relative; z-index: 2; }
  .bc__cat:hover { color: var(--green); }
  .bc__title { font-size: var(--fs-h4); letter-spacing: -0.025em; line-height: 1.15; }
  .bc--large .bc__title { font-size: var(--fs-h2); letter-spacing: -0.045em; line-height: 1; max-width: 20ch; }
  .bc__title a::after { content: ''; position: absolute; inset: 0; }
  .bc__title a { background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat; transition: background-size var(--t-med) var(--ease), color var(--t-fast); }
  .bc:hover .bc__title a { background-size: 100% 2px; color: var(--green); }
  .bc__desc { color: var(--ink-2); max-width: 40rem; font-size: 0.9875rem; }
  .bc--large .bc__desc { font-size: var(--fs-lg); }
  .bc__meta { display: flex; gap: var(--s-2); color: var(--muted); }
</style>
