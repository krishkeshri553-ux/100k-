---
/** Infinite marquee of what's in an edit. Pure CSS; pauses on hover; static with reduced motion. */
const items = ['Talking-head videos', 'Podcasts', 'Documentary', 'Educational', 'Business & finance', 'Faceless YouTube', 'B-roll', 'Sound design', 'Music', 'Colour', 'Thumbnails', 'Unlimited revisions'];
---
<div class="tick" aria-hidden="true">
  <div class="tick__track">
    {[0, 1].map(() => <ul role="list">{items.map((t) => <li>{t}<span>✦</span></li>)}</ul>)}
  </div>
</div>
<style>
  .tick { border-block: 1px solid var(--line); overflow: hidden; padding: 0.9rem 0; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .tick__track { display: flex; width: max-content; animation: tick 48s linear infinite; }
  .tick:hover .tick__track { animation-play-state: paused; }
  .tick ul { display: flex; }
  .tick li { display: inline-flex; align-items: center; gap: 1.5rem; padding-right: 1.5rem; white-space: nowrap; font-size: 0.875rem; font-weight: 500; color: var(--ink-2); }
  .tick span { color: var(--brand); font-size: 0.7rem; }
  @keyframes tick { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .tick__track { animation: none; } }
</style>
