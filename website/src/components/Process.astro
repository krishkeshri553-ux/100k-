---
/**
 * Five-step workflow drawn as clips on a timeline: each step is a segment
 * with an in-point timecode. Horizontal on desktop, vertical on mobile.
 */
import { process } from '../data/services';
import { cta } from '../config/site';

export interface Props { showCta?: boolean; as?: 'h1' | 'h2'; title?: string }
const { showCta = true } = Astro.props;
---
<section class="section proc" id="process" aria-labelledby="process-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow" data-reveal>How it works</p>
        <h2 id="process-title" class="h2" data-reveal style="--d:80ms">From raw footage to <em class="serif">final cut</em> in five steps.</h2>
      </div>
      <p class="lede" data-reveal style="--d:140ms">
        You send the footage and the brief. We handle everything between the first frame and the final export.
      </p>
    </div>

    <ol class="proc__track" role="list" data-reveal>
      {process.map((p) => (
        <li class="proc__step">
          <div class="proc__clip" aria-hidden="true">
            <span class="mono">{p.timecode}</span>
          </div>
          <span class="proc__num mono">Step {p.step}</span>
          <h3 class="proc__title">{p.title}</h3>
          <p>{p.body}</p>
        </li>
      ))}
    </ol>

    {showCta && (
      <div class="proc__cta" data-reveal>
        <a href={cta.primary.href} class="btn">{cta.primary.label} <span class="btn__arrow" aria-hidden="true">→</span></a>
      </div>
    )}
  </div>
</section>

<style>
  .proc__track { display: grid; gap: 0; position: relative; counter-reset: s; }
  .proc__step { position: relative; display: grid; align-content: start; gap: var(--s-2); padding: 0 0 var(--s-6) var(--s-6); border-left: 1px solid var(--line-strong); }
  .proc__step::before { content: ''; position: absolute; left: -5px; top: 0.2rem; width: 9px; height: 9px; background: var(--green); border-radius: 50%; }
  .proc__clip { display: none; }
  .proc__num { color: var(--green); text-transform: uppercase; }
  .proc__title { font-size: var(--fs-h4); letter-spacing: -0.025em; }
  .proc__step p { font-size: 0.9875rem; max-width: 26rem; }
  .proc__cta { margin-top: var(--s-7); display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-5); }

  @media (min-width: 1000px) {
    .proc__track { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 3px; }
    .proc__step { border-left: 0; padding: 0 var(--s-4) 0 0; gap: var(--s-3); }
    .proc__step::before { display: none; }
    .proc__clip {
      display: flex; align-items: flex-end; height: 4.5rem; margin-bottom: var(--s-4); padding: 0.5rem 0.6rem;
      background: var(--green-tint); border-left: 2px solid var(--green); border-radius: 2px; color: var(--green);
      transform-origin: left; transition: background var(--t-med) var(--ease);
    }
    .proc__step:nth-child(3) .proc__clip { background: var(--green); color: var(--white); }
    .proc__step:hover .proc__clip { background: var(--green-2); color: var(--white); }
    .js .proc__track .proc__clip { transform: scaleX(0); transition: transform 800ms var(--ease), background var(--t-med) var(--ease); }
    .js .proc__track.is-in .proc__clip { transform: none; }
    .js .proc__track .proc__step:nth-child(2) .proc__clip { transition-delay: 120ms, 0s; }
    .js .proc__track .proc__step:nth-child(3) .proc__clip { transition-delay: 240ms, 0s; }
    .js .proc__track .proc__step:nth-child(4) .proc__clip { transition-delay: 360ms, 0s; }
    .js .proc__track .proc__step:nth-child(5) .proc__clip { transition-delay: 480ms, 0s; }
  }
  @media (prefers-reduced-motion: reduce) { .js .proc__track .proc__clip { transform: none; } }
</style>
