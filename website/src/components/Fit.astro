---
/** Who the service is (and isn't) for. Honest scoping helps the right people convert. */
const yes = [
  'You publish videos of ten minutes or longer',
  'You want a reliable upload schedule',
  'You can record — you just don’t want to edit',
  'You care how the finished video looks and sounds',
];
const no = [
  'You need short-form clips, reels or shorts',
  'You want someone to manage your social accounts',
  'You need a crew to film for you',
  'You only want a thumbnail designed',
];
---
<section class="section fit" aria-labelledby="fit-title">
  <div class="container fit__grid">
    <div class="fit__intro">
      <p class="eyebrow" data-reveal>Who it's for</p>
      <h2 id="fit-title" class="h2" data-reveal style="--d:80ms">Built for long-form. <em class="serif">Not for everyone.</em></h2>
      <p class="lede" data-reveal style="--d:140ms">We'd rather tell you upfront than take on work we don't do.</p>
    </div>
    <div class="fit__cols">
      <div class="fit__col card" data-reveal>
        <h3 class="fit__h">A good fit if you…</h3>
        <ul role="list">{yes.map((t) => <li><span class="fit__i fit__i--y" aria-hidden="true">✓</span>{t}</li>)}</ul>
      </div>
      <div class="fit__col card fit__col--no" data-reveal style="--d:80ms">
        <h3 class="fit__h">Not a fit if you…</h3>
        <ul role="list">{no.map((t) => <li><span class="fit__i" aria-hidden="true">×</span>{t}</li>)}</ul>
      </div>
    </div>
  </div>
</section>
<style>
  .fit__grid { display: grid; gap: var(--s-7); }
  @media (min-width: 1000px) { .fit__grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr); gap: var(--s-8); align-items: center; } }
  .fit__intro { display: grid; gap: var(--s-5); }
  .fit__cols { display: grid; gap: var(--s-4); }
  @media (min-width: 680px) { .fit__cols { grid-template-columns: 1fr 1fr; } }
  .fit__col { padding: 1.5rem; }
  .fit__col:not(.fit__col--no) { border-color: rgb(47 209 128 / 0.3); box-shadow: 0 30px 80px -40px rgb(47 209 128 / 0.45); }
  .fit__h { font-size: 1.125rem; margin-bottom: 1rem; }
  .fit__col li { display: flex; gap: 0.7rem; padding: 0.6rem 0; border-top: 1px solid var(--line); font-size: 0.9375rem; color: var(--ink); }
  .fit__col--no li { color: var(--muted); }
  .fit__i { color: var(--muted); font-weight: 700; }
  .fit__i--y { color: var(--brand); }
</style>
