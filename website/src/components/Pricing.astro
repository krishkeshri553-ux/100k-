---
import { plans, formatPrice, perVideo } from '../config/pricing';

export interface Props { headingTag?: 'h1' | 'h2'; id?: string; /** Omit the section heading (when the page already has one). */ bare?: boolean }
const { headingTag: H = 'h2', id = 'pricing', bare = false } = Astro.props;
---
<section class="section price glow" id={id} aria-labelledby={bare ? undefined : 'pricing-title'} aria-label={bare ? 'Packages' : undefined}>
  <div class="container">
    {!bare && <div class="section-head section-head--split">
      <div>
        <p class="eyebrow" data-reveal>Pricing</p>
        <H id="pricing-title" class="h2" data-reveal style="--d:80ms">Clear prices. <em class="serif">No quote calls.</em></H>
      </div>
      <p class="lede" data-reveal style="--d:140ms">
        Start with one video, or set up a monthly plan for a steady publishing schedule.
      </p>
    </div>}

    <div class="plans">
      {plans.map((p, i) => (
        <article class:list={['plan', { 'plan--mid': i === 1 }]} data-reveal style={`--d:${i * 80}ms`} aria-labelledby={`plan-${p.id}`}>
          <header class="plan__head">
            <div class="plan__row">
              <h3 id={`plan-${p.id}`} class="plan__name">{p.name}</h3>
              <span class="tag">{p.recurring ? 'Monthly' : 'One-off'}</span>
            </div>
            <p class="plan__fit">{p.fit}</p>
          </header>

          <div class="plan__price">
            <span class="plan__amount">{formatPrice(p.price)}</span>
            <span class="plan__period">{p.period}</span>
          </div>
          <p class="plan__per mono">
            {p.videos > 1 ? `${p.videos} videos · ${formatPrice(perVideo(p))} each` : '1 video · pay once'}
          </p>

          <ul class="plan__list" role="list">
            {p.features.map((f) => (
              <li><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>{f}</li>
            ))}
          </ul>

          <a href={`/contact/?package=${p.id}`} class:list={['btn', 'btn--block', { 'btn--ghost': i !== 1 }]}>
            {p.cta} <span class="btn__arrow" aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>

    <p class="price__note muted" data-reveal>
      Prices in USD. Not sure which plan fits? <a href="/contact/?package=unsure" class="link">Tell us about your channel</a> and we'll recommend one.
    </p>
  </div>
</section>

<style>
  .price { --gy: 55%; }
  .plans { display: grid; gap: var(--s-4); align-items: stretch; }
  @media (min-width: 960px) { .plans { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .plan {
    display: flex; flex-direction: column; gap: var(--s-5); position: relative;
    padding: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem); border-radius: var(--r-3);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.01)); border: 1px solid var(--line);
  }
  .plan--mid { border-color: rgb(47 209 128 / 0.55); background: linear-gradient(180deg, rgb(47 209 128 / 0.12), rgb(47 209 128 / 0.02) 50%), var(--surface); box-shadow: 0 30px 100px -30px rgb(47 209 128 / 0.5); }
  @media (min-width: 960px) { .plan--mid { transform: translateY(-12px); } }
  .plan__head { display: grid; gap: var(--s-3); }
  .plan__row { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); }
  .plan__name { font-size: var(--fs-h4); }
  .plan--mid .tag { color: var(--brand); border-color: rgb(47 209 128 / 0.4); background: var(--brand-soft); }
  .plan__fit { font-size: 0.9rem; min-height: 3em; color: var(--ink-2); }
  .plan__price { display: flex; align-items: baseline; gap: var(--s-2); }
  .plan__amount { font-family: var(--font-display); font-size: clamp(3rem, 2.4rem + 2.4vw, 4.25rem); font-weight: 800; letter-spacing: -0.05em; color: var(--ink); line-height: 1; }
  .plan__period { color: var(--muted); font-size: 0.9rem; }
  .plan__per { color: var(--brand); margin-top: calc(var(--s-4) * -1); text-transform: uppercase; letter-spacing: 0.1em; }
  .plan__list { display: grid; flex: 1; align-content: start; gap: 0.15rem; }
  .plan__list li { display: flex; gap: var(--s-3); align-items: flex-start; padding: 0.45rem 0; font-size: 0.9rem; color: var(--ink); }
  .plan__list svg { width: 1rem; flex: none; margin-top: 0.25rem; color: var(--brand); }
  .price__note { margin-top: var(--s-6); font-size: var(--fs-sm); text-align: center; }
</style>
