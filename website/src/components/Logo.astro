---
/**
 * Wordmark. The icon is an in-point / out-point bracket pair around a clip —
 * the marks an editor sets to define a cut. Replace with supplied logo assets
 * by swapping this markup (keep the aria-label).
 */
export interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class={`logo ${cls}`} aria-label="Longform Edits">
  <span class="logo__tile" aria-hidden="true">
    <svg viewBox="0 0 28 28" focusable="false">
      <path d="M5 5h6v2.6H7.6v12.8H11V23H5z" fill="currentColor" />
      <path d="M23 5h-6v2.6h3.4v12.8H17V23h6z" fill="currentColor" />
      <rect x="12.2" y="10" width="3.6" height="8" rx="0.6" fill="#021209" />
    </svg>
  </span>
  <span class="logo__word" aria-hidden="true">Longform<span class="logo__soft">Edits</span></span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.55rem; line-height: 1; color: var(--ink); }
  .logo__tile {
    width: 1.75rem; height: 1.75rem; border-radius: 0.5rem; display: grid; place-items: center; flex: none;
    background: linear-gradient(160deg, #5fe3a0, #149a5a); color: #021209;
    box-shadow: 0 0 18px -2px rgb(47 209 128 / 0.55), inset 0 1px 0 rgb(255 255 255 / 0.35);
  }
  .logo__tile svg { width: 1.2rem; height: 1.2rem; }
  .logo__word { font-family: var(--font-display); font-weight: 800; font-size: 1.0625rem; letter-spacing: -0.04em; }
  .logo__soft { color: var(--brand); margin-left: 0.12em; }
</style>
