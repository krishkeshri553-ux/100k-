---
import { formats } from '../data/services';
export interface Props { /** Two-column, smaller type — used on the homepage. */ compact?: boolean }
const { compact = false } = Astro.props;
---
<section class="section sunken formats" aria-labelledby="formats-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow" data-reveal>What we edit</p>
        <h2 id="formats-title" class="h2" data-reveal style="--d:80ms">Eight formats. <em class="serif">One length:</em> long.</h2>
      </div>
      <p class="lede" data-reveal style="--d:140ms">
        Different formats need different editing instincts. All eight are part of the same service,
        and every one is edited to be watched start to finish.
      </p>
    </div>

    <ol class:list={['fmt', { 'fmt--compact': compact }]} role="list">
      {formats.map((f, i) => (
        <li class="fmt__row" data-reveal style={`--d:${(i % 4) * 50}ms`}>
          <span class="fmt__num mono">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="fmt__name">{f.name}</h3>
          <p class="fmt__detail">{f.detail}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .fmt { border-top: 1px solid var(--line-strong); }
  .fmt__row { display: grid; grid-template-columns: 2.5rem 1fr; gap: var(--s-2) var(--s-4); padding: var(--s-5) 0; border-bottom: 1px solid var(--line); }
  .fmt__num { color: var(--green); padding-top: 0.6em; }
  .fmt__name { font-size: clamp(1.625rem, 1.1rem + 2.4vw, 3.25rem); letter-spacing: -0.035em; line-height: 1; transition: color var(--t-med) var(--ease), transform var(--t-med) var(--ease); }
  .fmt__detail { grid-column: 2; color: var(--ink-2); max-width: 30rem; font-size: 0.9875rem; }
  .fmt--compact .fmt__name { font-size: clamp(1.375rem, 1.1rem + 1vw, 1.875rem); letter-spacing: -0.03em; }
  .fmt--compact .fmt__detail { font-size: var(--fs-sm); }
  @media (min-width: 900px) {
    .fmt--compact { display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--s-8); border-top: 0; }
    .fmt--compact .fmt__row { grid-template-columns: 2.5rem 1fr; align-items: start; gap: var(--s-2) var(--s-3); border-top: 1px solid var(--line); border-bottom: 0; }
    .fmt--compact .fmt__detail { grid-column: 2; }
  }
  @media (min-width: 900px) {
    .fmt:not(.fmt--compact) .fmt__row { grid-template-columns: 3.5rem minmax(0, 1.25fr) minmax(0, 1fr); align-items: center; gap: var(--s-6); padding: var(--s-5) 0; }
    .fmt:not(.fmt--compact) .fmt__detail { grid-column: 3; }
    .fmt__row:hover .fmt__name { color: var(--green); transform: translateX(0.5rem); }
  }
</style>
