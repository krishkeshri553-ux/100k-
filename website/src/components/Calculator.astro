---
/**
 * "Put a number on your editing time." Every output is derived from the
 * visitor's own inputs plus the published packages in src/config/pricing.ts.
 */
import { plans } from '../config/pricing';
import { cta } from '../config/site';
const planData = plans.map((p) => ({ id: p.id, name: p.name, price: p.price, videos: p.videos, recurring: p.recurring }));
---
<section class="section calc" id="calculator" aria-labelledby="calc-title">
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow" data-reveal>What editing costs you</p>
        <h2 id="calc-title" class="h2" data-reveal style="--d:80ms">Put a number on <em class="serif">your hours.</em></h2>
      </div>
      <p class="lede" data-reveal style="--d:140ms">Move the sliders and be honest about how long your edits take. Everything below is an estimate from your numbers and our published prices.</p>
    </div>

    <div class="calc__box card" data-calc data-plans={JSON.stringify(planData)} data-reveal>
      <div class="calc__inputs">
        <p class="mono calc__kicker">Calculator</p>
        <h3 class="calc__h">Calculate what editing is costing you.</h3>
        <label class="calc__field">
          <span>Long-form videos per month <output data-out="videos">4</output></span>
          <input type="range" min="1" max="8" step="1" value="4" data-in="videos" />
          <span class="calc__scale mono"><span>1</span><span>8</span></span>
        </label>
        <label class="calc__field">
          <span>Hours you spend editing each video <output data-out="hours">8</output></span>
          <input type="range" min="1" max="20" step="1" value="8" data-in="hours" />
          <span class="calc__scale mono"><span>1 h</span><span>20 h</span></span>
        </label>
        <label class="calc__field">
          <span>What an hour of your time is worth <output data-out="rate">$75</output></span>
          <input type="range" min="20" max="500" step="5" value="75" data-in="rate" />
          <span class="calc__scale mono"><span>$20</span><span>$500</span></span>
        </label>
      </div>
      <div class="calc__out">
        <div class="calc__grid">
          <div><p class="mono">Hours editing / month</p><p class="calc__num" data-r="hrs">32</p></div>
          <div><p class="mono">Value of that time / month</p><p class="calc__num calc__num--warn" data-r="value">$2,400</p></div>
          <div><p class="mono">Longform Edits / month</p><p class="calc__num" data-r="cost">$449</p><p class="calc__plan" data-r="plan">4 Videos plan</p></div>
          <div><p class="mono">Hours back / year</p><p class="calc__num calc__num--brand" data-r="year">384</p></div>
        </div>
        <div class="calc__save">
          <p class="mono">Estimated difference every month</p>
          <p class="calc__big" data-r="save">$1,951</p>
        </div>
        <a href={cta.primary.href} class="btn btn--block" data-calc-cta>Get those hours back — {cta.primary.label} <span aria-hidden="true">↗</span></a>
        <p class="calc__fine">An estimate only: your time value minus the cheapest published package that covers your volume. It isn't a quote or a promise of results.</p>
      </div>
    </div>
  </div>
</section>
<script>
  const box = document.querySelector<HTMLElement>('[data-calc]');
  if (box) {
    type P = { id: string; name: string; price: number; videos: number; recurring: boolean };
    const plans: P[] = JSON.parse(box.dataset.plans!);
    const money = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
    const q = (s: string) => box.querySelector<HTMLElement>(s)!;
    const inp = (k: string) => Number((box.querySelector(`[data-in="${k}"]`) as HTMLInputElement).value);
    const cheapest = (n: number) => {
      const options = plans.map((p) => (p.recurring ? (n <= p.videos ? { p, cost: p.price } : null) : { p, cost: p.price * n })).filter(Boolean) as { p: P; cost: number }[];
      return options.sort((a, b) => a.cost - b.cost)[0];
    };
    const render = () => {
      const v = inp('videos'), h = inp('hours'), r = inp('rate');
      q('[data-out="videos"]').textContent = String(v);
      q('[data-out="hours"]').textContent = String(h);
      q('[data-out="rate"]').textContent = money(r);
      const hrs = v * h, value = hrs * r, best = cheapest(v);
      q('[data-r="hrs"]').textContent = String(hrs);
      q('[data-r="value"]').textContent = money(value);
      q('[data-r="cost"]').textContent = money(best.cost);
      q('[data-r="plan"]').textContent = best.p.recurring ? `${best.p.name} plan` : `${v} × ${best.p.name}`;
      q('[data-r="year"]').textContent = (hrs * 12).toLocaleString('en-US');
      const save = value - best.cost;
      q('[data-r="save"]').textContent = (save < 0 ? '−' : '') + money(Math.abs(save));
      q('[data-r="save"]').classList.toggle('is-neg', save < 0);
      (box.querySelector('[data-calc-cta]') as HTMLAnchorElement).href = `/contact/?package=${best.p.id}`;
      box.querySelectorAll<HTMLInputElement>('input[type=range]').forEach((el) => {
        const pct = ((Number(el.value) - Number(el.min)) / (Number(el.max) - Number(el.min))) * 100;
        el.style.setProperty('--p', pct + '%');
      });
    };
    box.addEventListener('input', render);
    render();
  }
</script>
<style>
  .calc__box { display: grid; overflow: hidden; box-shadow: 0 40px 120px -50px rgb(47 209 128 / 0.4); }
  @media (min-width: 960px) { .calc__box { grid-template-columns: 1fr 1.05fr; } }
  .calc__inputs { padding: clamp(1.5rem, 1rem + 2vw, 2.75rem); display: grid; gap: var(--s-5); align-content: start; }
  .calc__kicker { color: var(--brand); text-transform: uppercase; letter-spacing: 0.14em; }
  .calc__h { font-size: var(--fs-h3); max-width: 14ch; }
  .calc__field { display: grid; gap: 0.6rem; color: var(--ink); font-weight: 600; font-size: 0.9375rem; }
  .calc__field > span:first-child { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-3); }
  .calc__field output { font-family: var(--font-display); font-weight: 800; font-size: 1.5rem; letter-spacing: -0.03em; }
  .calc__scale { display: flex; justify-content: space-between; color: var(--muted); font-weight: 400; }
  .calc__field input[type=range] { -webkit-appearance: none; appearance: none; width: 100%; height: 4px; border-radius: 4px; background: linear-gradient(90deg, var(--brand) var(--p, 50%), rgb(255 255 255 / 0.12) var(--p, 50%)); }
  .calc__field input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; border-radius: 50%; background: #fff; border: 4px solid var(--brand); box-shadow: 0 0 14px rgb(47 209 128 / 0.6); cursor: pointer; }
  .calc__field input[type=range]::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: #fff; border: 4px solid var(--brand); cursor: pointer; }
  .calc__out { padding: clamp(1.5rem, 1rem + 2vw, 2.75rem); display: grid; gap: var(--s-5); align-content: start; background: linear-gradient(160deg, rgb(47 209 128 / 0.1), transparent 60%), var(--bg-soft); border-top: 1px solid var(--line); }
  @media (min-width: 960px) { .calc__out { border-top: 0; border-left: 1px solid var(--line); } }
  .calc__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-5); }
  .calc__grid .mono, .calc__save .mono { color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; font-size: 0.5625rem; }
  .calc__num { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.75rem, 1.3rem + 1.5vw, 2.5rem); letter-spacing: -0.04em; color: var(--ink); line-height: 1.1; }
  .calc__num--warn { color: #ff8a73; }
  .calc__num--brand { color: var(--brand); }
  .calc__plan { font-size: 0.75rem; color: var(--muted); }
  .calc__save { padding: 1.25rem 1.4rem; border-radius: var(--r-2); background: rgb(0 0 0 / 0.35); border: 1px solid var(--line); }
  .calc__big { font-family: var(--font-display); font-weight: 800; font-size: clamp(2.5rem, 1.8rem + 3vw, 4.25rem); letter-spacing: -0.05em; line-height: 1.05; background: linear-gradient(180deg, #b8ffd8, var(--brand)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .calc__big.is-neg { background: none; color: var(--ink-2); }
  .calc__out .btn { white-space: normal; text-align: center; line-height: 1.3; padding-block: 0.9rem; }
  .calc__fine { font-size: 0.75rem; color: var(--muted); }
</style>
