---
import { cta } from '../config/site';

export interface Props { title?: string; body?: string }
const {
  title = 'Your next video is already recorded.',
  body = 'Send us the footage and a short brief. We\u2019ll turn it into a video you\u2019re proud to publish.',
} = Astro.props;
---
<section class="fcta on-dark" aria-labelledby="fcta-title">
  <div class="container fcta__inner">
    <p class="eyebrow" data-reveal>Start here</p>
    <h2 id="fcta-title" class="fcta__title" data-reveal style="--d:80ms">
      {title.split(' ').slice(0, -1).join(' ')} <em class="serif">{title.split(' ').slice(-1)}</em>
    </h2>
    <p class="lede" data-reveal style="--d:140ms">{body}</p>
    <div class="fcta__actions" data-reveal style="--d:200ms">
      <a href={cta.primary.href} class="btn">{cta.primary.label} <span class="btn__arrow" aria-hidden="true">→</span></a>
      <a href="/pricing/" class="btn btn--ghost">See pricing</a>
    </div>
  </div>
</section>

<style>
  .fcta { position: relative; padding-block: var(--section); overflow: hidden; background: var(--forest); border-bottom: 1px solid var(--forest-line); }
  .fcta__inner { display: grid; gap: var(--s-5); justify-items: start; position: relative; z-index: 1; }
  .fcta__title { font-size: var(--fs-h1); letter-spacing: -0.038em; line-height: 0.98; max-width: 8em; }
  .fcta__title em { color: var(--signal); }
  .fcta__actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-3); }
</style>
