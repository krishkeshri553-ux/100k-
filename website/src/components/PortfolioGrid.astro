---
/**
 * Full portfolio layout: an asymmetric editorial grid (wide / narrow pairs,
 * alternating sides). Filters appear only when there is enough real work.
 */
import Media from './Media.astro';
import { portfolio, realProjects, MIN_ITEMS_FOR_FILTERS, type PortfolioItem } from '../data/portfolio';

const items: PortfolioItem[] = realProjects.length ? [...realProjects, ...portfolio.filter((p) => p.placeholder)] : portfolio;
const showFilters = realProjects.length >= MIN_ITEMS_FOR_FILTERS;
const cats = [...new Set(realProjects.map((p) => p.category))];
---
{showFilters && (
  <div class="pf__filters" role="toolbar" aria-label="Filter projects by format" data-filters>
    <button type="button" aria-pressed="true" data-filter="all">All</button>
    {cats.map((c) => <button type="button" aria-pressed="false" data-filter={c}>{c}</button>)}
  </div>
)}

<ul class="pf" role="list">
  {items.map((item, i) => (
    <li id={item.slug} class:list={['pf__item', `pf__item--${i % 4}`]} data-category={item.category} data-reveal>
      <article aria-labelledby={`${item.slug}-t`}>
        <Media item={item} eager={i === 0} />
        <div class="pf__meta">
          <span class="pf__num mono">{String(i + 1).padStart(2, '0')}</span>
          <div class="pf__text">
            <h2 id={`${item.slug}-t`} class="pf__title">{item.title}</h2>
            <p class="pf__desc">{item.description}</p>
            {item.client && <p class="pf__client mono">Client — {item.client}</p>}
          </div>
          <div class="pf__tags">
            <span class="tag">{item.category}</span>
            {item.runtime && <span class="tag">{item.runtime}</span>}
            {item.placeholder && <span class="tag tag--placeholder">Placeholder</span>}
          </div>
        </div>
      </article>
    </li>
  ))}
</ul>

<script>
  const bar = document.querySelector<HTMLElement>('[data-filters]');
  if (bar) {
    const btns = bar.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cards = document.querySelectorAll<HTMLElement>('.pf__item');
    btns.forEach((b) => b.addEventListener('click', () => {
      const f = b.dataset.filter!;
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      cards.forEach((c) => { c.hidden = f !== 'all' && c.dataset.category !== f; });
    }));
  }
</script>

<style>
  .pf__filters { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-bottom: var(--s-7); }
  .pf__filters button { padding: 0.55rem 1rem; border: 1px solid var(--line-strong); border-radius: var(--r-pill); font-size: 0.9375rem; font-weight: 500; }
  .pf__filters button[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .pf { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: clamp(2.5rem, 2rem + 3vw, 5rem) var(--gutter); }
  .pf__item { grid-column: 1 / -1; scroll-margin-top: 6rem; }
  @media (min-width: 900px) {
    .pf__item--0 { grid-column: 1 / span 8; }
    .pf__item--1 { grid-column: 9 / span 4; margin-top: 30%; }
    .pf__item--2 { grid-column: 1 / span 5; }
    .pf__item--3 { grid-column: 6 / span 7; margin-top: -10%; }
  }
  .pf__meta { display: grid; grid-template-columns: 2.25rem 1fr; gap: var(--s-3) var(--s-3); padding-top: var(--s-4); }
  .pf__num { color: var(--green); padding-top: 0.3rem; }
  .pf__title { font-size: var(--fs-h4); letter-spacing: -0.025em; line-height: 1.15; }
  .pf__desc { font-size: var(--fs-sm); color: var(--muted); margin-top: var(--s-1); max-width: 34rem; }
  .pf__client { color: var(--ink-2); margin-top: var(--s-2); }
  .pf__tags { grid-column: 2; display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .pf__item :global(.media__el) { transition: transform var(--t-slow) var(--ease); }
  .pf__item:hover :global(.media__el) { transform: scale(1.02); }
</style>
