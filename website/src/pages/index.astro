---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import Showreel from '../components/Showreel.astro';
import Problem from '../components/Problem.astro';
import Compare from '../components/Compare.astro';
import PinnedWords from '../components/PinnedWords.astro';
import FormatsRail from '../components/FormatsRail.astro';
import ProcessWheel from '../components/ProcessWheel.astro';
import Calculator from '../components/Calculator.astro';
import Pricing from '../components/Pricing.astro';
import BigMarquee from '../components/BigMarquee.astro';
import Fit from '../components/Fit.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import { serviceSchema } from '../lib/schema';
import { formatPrice, lowestPrice, facts } from '../config/pricing';
---
<Base
  title="Longform Edits — Done-for-You Long-Form Video Editing"
  description={`Professional long-form video editing for YouTube creators, podcasters, educators and brands. From ${formatPrice(lowestPrice)} per video, first draft in ${facts.firstDraft}, unlimited revisions.`}
  path="/"
  schema={[serviceSchema()]}
>
  <Hero />
  <Ticker />
  <Showreel />
  <Problem />
  <Compare />
  <PinnedWords />
  <FormatsRail />
  <ProcessWheel />
  <Calculator />
  <Pricing />
  <BigMarquee />
  <Fit />
  <Faq limit={6} more />
  <FinalCta />
</Base>
