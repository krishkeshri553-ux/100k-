---
import Base from '../layouts/Base.astro';
import { cta } from '../config/site';
---
<Base title="Page not found" description="This page doesn't exist. Head back to Longform Edits." path="/404/" noindex>
  <section class="section">
    <div class="container nf">
      <p class="eyebrow">Error 404</p>
      <h1 class="h1">This scene was <em class="serif">cut.</em></h1>
      <p class="lede">The page you're looking for doesn't exist or has moved.</p>
      <div class="nf__ctas">
        <a href="/" class="btn">Back to home</a>
        <a href={cta.primary.href} class="btn btn--ghost">{cta.primary.label}</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf { display: grid; gap: var(--s-5); }
  .nf em { color: var(--green); }
  .nf__ctas { display: flex; flex-wrap: wrap; gap: var(--s-3); }
</style>
