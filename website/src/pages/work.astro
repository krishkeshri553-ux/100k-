---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PortfolioGrid from '../components/PortfolioGrid.astro';
import PortfolioPending from '../components/PortfolioPending.astro';
import FinalCta from '../components/FinalCta.astro';
import { hasRealWork } from '../data/portfolio';
import { breadcrumbSchema } from '../lib/schema';

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Work', path: '/work/' }];
---
<Base
  title="Our Work — Long-Form Video Editing Portfolio"
  description="Long-form video edits by Longform Edits across talking-head, podcast, documentary, educational, business and faceless YouTube formats."
  path="/work/"
  schema={[breadcrumbSchema(crumbs)]}
>
  <PageHero
    crumbs={crumbs}
    eyebrow="Work"
    title="Judge us by the cut."
    lede={hasRealWork
      ? 'Long-form edits across the formats we work in. Every project here was edited by our team.'
      : 'Where our long-form edits live: talking-head, podcast, documentary, educational, business and faceless videos.'}
  />
  <section class="section">
    <div class="container">
      {hasRealWork ? <PortfolioGrid /> : <PortfolioPending />}
    </div>
  </section>
  <FinalCta title="Want to see it on your footage?" body="The quickest way to judge an editor is a real video. Start with a Single Video and see exactly what we do with your recording." />
</Base>
