# Copy to .env for local development only. NEVER commit real values.
# In production these live in GitHub Actions secrets and Vercel environment variables.

APP_ENV=development            # development | production
OWNER_NAME="Krish Keshri"
OWNER_LINKEDIN_URL=            # e.g. https://www.linkedin.com/in/your-handle (used to tell your messages apart in exports)
OWNER_TIMEZONE=Asia/Kolkata
OWNER_EMAIL=                   # used as the calendar organiser label only

# Claude API (AI intelligence). Without it, deterministic fallbacks run and AI-only steps are skipped and logged.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Supabase (persistent database). Service role key is server-side only (GitHub Actions + Vercel functions).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=               # postgres connection string, only for the migration workflow

# Revenue Command Tracker access
TRACKER_PASSPHRASE=            # long random passphrase you type to log in
TRACKER_SESSION_SECRET=        # 32+ random bytes (hex) used to sign session cookies

# Google Calendar (OAuth 2.0, offline access, scope https://www.googleapis.com/auth/calendar.events + calendar.freebusy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Notifications (Slack or Discord incoming-webhook URL). Optional.
NOTIFY_WEBHOOK_URL=

# Backups (AES-256-GCM). 64 hex chars. Optional but strongly recommended.
BACKUP_ENCRYPTION_KEY=
